{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Journey - multi-modal travel comparison platform",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --delay 500ms server.js",
    "seed": "node seed/seedData.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "import:demo-catalog": "node scripts/importDemoTransportCatalog.js",
    "import:attached-data": "node scripts/importAttachedTransportData.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.0",
    "nodemon": "^3.1.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
