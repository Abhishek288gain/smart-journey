# Local development only. Replace every value before deployment.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Prisma SQLite file is relative to backend/prisma/
DATABASE_URL="file:./dev.db"

# Generate separate random secrets for your own .env; never commit real secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TICKET_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Development mock emits an OTP in the API response; set to sms when Twilio is configured.
# Production startup rejects OTP_MODE=mock.
OTP_MODE=mock

# Explicit demo mode. For real checkout set PAYMENT_MODE=live and enter Razorpay keys.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local Redis. Required in production.
REDIS_URL=redis://127.0.0.1:6379

# Optional real OTP and notification delivery. Twilio sends SMS; Resend sends email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Current inventory providers are demo/database backed; these are descriptive only.
TRAIN_DATA_PROVIDER=mock
BUS_DATA_PROVIDER=mock

# SerpApi Google Flights search (keep the real key in backend/.env only).
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
# Optional Aviationstack status-only fallback.
AVIATIONSTACK_ACCESS_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
